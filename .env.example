# Copie para .env. Em produção (cPanel > Bancos de dados MySQL): mysql://USUARIO:SENHA@localhost:3306/BANCO
# (usuário e banco do cPanel vêm com o prefixo da conta, ex. acidi_site). Senha com caracteres especiais: use encodeURIComponent.
# Copie para .env. No .env.test, DATABASE_URL e TEST_DATABASE_URL apontam ambos para o banco de teste.
DATABASE_URL=mysql://acidi:acidi@localhost:3307/acidi
TEST_DATABASE_URL=mysql://acidi:acidi@localhost:3307/acidi_teste
BETTER_AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
BETTER_AUTH_URL=http://localhost:3000
# disco (UPLOAD_DIR) ou s3. Supabase Storage: S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3,
# S3_URL_PUBLICA=https://<ref>.supabase.co/storage/v1/object/public/<bucket>, chaves em Storage > S3 Access Keys
STORAGE=disco
UPLOAD_DIR=dados/uploads
# STORAGE=ftp: fotos numa pasta do FTP (ex.: a conta FTP do cPanel), lidas de volta pela rota /uploads/<arquivo>.
# FTP_DIR é relativo à pasta inicial do usuário FTP. FTP_SEGURO=false só se o servidor não aceitar TLS.
FTP_HOST=
FTP_PORT=21
FTP_USUARIO=
FTP_SENHA=
FTP_DIR=uploads
FTP_SEGURO=true
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_URL_PUBLICA=
# Aviso por e-mail das mensagens do site (Resend). Sem chave, as mensagens só ficam no admin.
RESEND_API_KEY=
CONTATO_EMAIL_DE=Site ACIDI <site@acidi.net>
CONTATO_EMAIL_PARA=contato@acidi.net
